# Backend (copy to backend/.env for local runs)
# Supabase: Project Settings > Database > Connection string (use the pooler URI). Leave empty for local SQLite.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Free key from https://aistudio.google.com/ (chat slot reading, policy reading, contract PDF fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma separated origins allowed to call the API (your Vercel URL)
CORS_ORIGINS=*

# Frontend build-time (Vercel): the public URL of the backend, e.g. https://corvo-api.onrender.com
VITE_API_URL=
