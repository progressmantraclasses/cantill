# ===================== Backend =====================
# Copy this file to backend/.env for local runs:
#   cp .env.example backend/.env          (macOS / Linux / Git Bash)
#   Copy-Item .env.example backend\.env   (Windows PowerShell)
# backend/.env is git-ignored. Never put real passwords in this file.

# Leave both empty to use local SQLite (backend/cantill.db, created automatically).
# Supabase: Project Settings > Database > Connection string. URL-encode special characters in the
# password (+ -> %2B, % -> %25, @ -> %40, # -> %23).
#
# Runtime connection: transaction-mode pooler (port 6543), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
# Used only to create tables: session-mode pooler (port 5432). Optional, e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Optional. Free key from https://aistudio.google.com/
# Enables AI chat slot extraction, policy reading and contract-PDF fallback.
# Without it everything still works (regex extraction, manual policy editor, template PDF parser).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated origins allowed to call the API (put your Vercel URL here in production).
CORS_ORIGINS=*

# ===================== Frontend (build time) =====================
# Public URL of the backend, e.g. https://corvo-api.onrender.com
# Leave empty locally: the Vite dev server proxies /api to http://localhost:8000.
VITE_API_URL=
